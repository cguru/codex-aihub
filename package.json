{
  "name": "codex-aihub",
  "version": "0.3.0",
  "description": "Codex plugin for discovering AI Hub datasets and safely downloading selected approved files.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/cguru/codex-aihub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cguru/codex-aihub.git"
  },
  "bugs": {
