{
  "mcpServers": {
    "aihub": {
      "title": "AI Hub",
      "description": "Search AI Hub datasets and safely download selected approved files.",
      "cwd": ".",
      "command": "node",
      "args": [
        "./dist/server.mjs",
        "--stdio"
      ],
      "env_vars": [
        "AIHUB_API_KEY",
        "AIHUB_METADATA_BASE_URL",
        "AIHUB_REQUEST_TIMEOUT_MS",
        "AIHUB_DOWNLOAD_BASE_URL",
        "AIHUB_DOWNLOAD_VERSION",
        "AIHUB_DOWNLOAD_TIMEOUT_MS"
      ],
      "tool_timeout_sec": 3600
    }
  }
}
